# Copy this file to .env (same folder) and fill it in. Never commit .env.
# Supabase project URL and the SERVICE ROLE key (Project Settings > API). This key skips
# row-level security, so it stays on this laptop only.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# The Blue Alliance read key, used to find match videos (the same one official-sync uses)
TBA_API_KEY=
# Optional: a different bumper model than models/bumpers.pt
# RS_MODEL=C:\path\to\best.pt
# Optional: a Roboflow API key (Settings > API Keys), only for "python run.py universe"
# ROBOFLOW_API_KEY=
